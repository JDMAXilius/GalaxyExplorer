# Line endings: let git normalise text in the repo, check out native on Windows.
* text=auto

*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.md        text
*.json      text
*.xml       text
*.txt       text
*.ps1       text
*.py        text

# Unity YAML: text, but never merged automatically — a bad merge silently
# corrupts a scene or prefab. Resolve these by picking a side or by redoing
# the change in the editor.
*.unity     text merge=binary
*.prefab    text merge=binary
*.asset     text merge=binary
*.mat       text merge=binary
*.anim      text merge=binary
*.controller text merge=binary
*.physicMaterial text merge=binary
*.meta      text merge=binary

# Binary assets: never touch line endings, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.tif  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.glb  binary
*.gltf binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.so   binary
*.a    binary
*.apk  binary
*.aab  binary
*.unitypackage binary
*.pdf  binary
*.zip  binary
